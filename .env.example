# Local docker-compose Postgres (see docker-compose.yml).
DATABASE_URL=postgres://crossrank:crossrank@127.0.0.1:5433/crossrank

# API port. The Vite dev server proxies /api to this port.
PORT=4317

# Local embedding model. 384 dimensions, downloaded on first use.
# bge-small-en-v1.5 is the default: same size class as all-MiniLM-L6-v2,
# and stronger at short-query retrieval. Set the MiniLM id to compare.
EMBEDDING_MODEL=Xenova/bge-small-en-v1.5

# Optional. If set, seed and search call OpenAI instead of the local model.
# text-embedding-3-small is requested at 384 dimensions so it fits the column.
# Re-seed after switching provider. Do not commit a real key.
# OPENAI_API_KEY=
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Reciprocal Rank Fusion constant. 60 is the usual default.
RRF_K=60
